{
  "description": "input 객체는 재귀 병합되므로 부모의 template을 물려받은 자식이 fn을 선언하면 두 키가 함께 남고 fn의 결과가 사용자 메시지가 된다.",
  "spec": [
    "입력",
    "상속과 제거"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료"
          }
        ]
      }
    },
    "functions": {
      "shout": {
        "op": "textSuffix",
        "suffix": "!"
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
