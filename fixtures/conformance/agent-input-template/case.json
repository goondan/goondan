{
  "description": "input.template은 에이전트 입력이 객체이면 각 키를, 객체가 아니면 그 값을 text 변수로 받아 사용자 메시지를 렌더링한다.",
  "spec": [
    "입력"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "하나"
          },
          {
            "text": "둘"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    },
    {
      "run": {
        "conversationId": "c2",
        "input": {
          "text": "군단",
          "extra": 1
        }
      }
    }
  ]
}
