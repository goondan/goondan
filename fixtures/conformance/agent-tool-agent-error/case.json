{
  "description": "에이전트 도구의 대상 실행이 실패하면 부모 실행은 그 호출을 가진 tool_error 실행 오류를 받고, 하위 실행의 이벤트는 자신의 에이전트 이름와 하위 세션 식별자로 발생한다.",
  "spec": [
    "에이전트 도구",
    "실행 오류"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "w-1",
                "name": "worker",
                "args": {
                  "task": "x"
                }
              }
            ]
          }
        ]
      },
      "w": {
        "responses": [
          {
            "error": "작업자 실패"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "부탁해"
      }
    }
  ]
}
