{
  "description": "에이전트 도구는 호출 인수를 턴 입력으로 삼아 대상 에이전트를 파생 세션에서 실행하고, 그 출력 메시지의 content가 도구 결과가 되며 실행 기록에 tool 항목을 만든다.",
  "spec": [
    "에이전트 도구",
    "파생 세션",
    "에이전트 실행 기록"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "w-1",
                "name": "worker",
                "args": {
                  "task": "정리"
                }
              }
            ],
            "usage": {
              "input": 5,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 8,
              "output": 2
            }
          }
        ]
      },
      "w": {
        "responses": [
          {
            "text": "정리 완료",
            "usage": {
              "input": 3,
              "output": 1
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "부탁해"
      }
    }
  ]
}
