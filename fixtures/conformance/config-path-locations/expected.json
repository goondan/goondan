{
  "steps": [

  ],
  "observations": {
    "effectiveConfig": {
      "version": 1,
      "name": "goondan",
      "agents": {
        "main": {
          "model": "m",
          "systemMessage": [
            {
              "template": "<case>/config/sys-a.md"
            },
            {
              "text": "인라인 블록"
            }
          ],
          "hooks": {
            "modelInput": [
              {
                "template": "<case>/config/hook.md"
              }
            ]
          }
        },
        "second": {
          "model": "m"
        }
      },
      "routes": [
