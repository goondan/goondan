{
  "description": "파생 세션에서 만든 승인 작업은 작업 별칭으로 그 파생 sessionId를 찾아 결정하며 stateless 대상은 작업 완료 전달에도 새 인스턴스를 쓴다.",
  "spec": ["파생 세션", "승인된 작업의 실행", "인스턴스"],
  "bindings": {
    "models": {
      "mainModel": {"responses": [{"text": "완료"}]},
      "workerModel": {"responses": [
        {"toolCalls": [{"callId": "d-1", "name": "danger", "args": {}}]},
        {"text": "대기합니다"}
      ]}
    },
    "tools": {
      "danger": {"description": "위험 작업", "results": [{"text": "실행 완료"}]}
    },
    "extensions": {
      "trace": {"instance": {}}
    }
  },
  "steps": [
    {"run": {"sessionId": "s", "input": "실행"}},
    {"decide": {"operation": "<op:d-1>", "value": {"decision": "approved"}}}
  ]
}
