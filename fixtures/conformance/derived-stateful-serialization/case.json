{
  "description": "같은 부모 턴의 비동기 agents.run 두 호출이 같은 stateful 대상과 파생 세션을 쓰면 대상 실행은 요청 순서대로 직렬화된다.",
  "spec": ["파생 세션", "인스턴스", "비동기 훅"],
  "bindings": {
    "models": {
      "mainModel": {"responses": [{"text": "완료"}]},
      "workerModel": {"responses": [
        {"await": "worker-1", "then": {"text": "하나"}},
        {"await": "worker-2", "then": {"text": "둘"}}
      ]}
    }
  },
  "steps": [
    {"parallel": [
      [{"run": {"sessionId": "s", "input": "원본"}}],
      [
        {"reach": "worker-1"},
        {"release": "worker-1"},
        {"reach": "worker-2"},
        {"release": "worker-2"}
      ]
    ]}
  ]
}
