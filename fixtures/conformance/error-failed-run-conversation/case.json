{
  "description": "실패한 실행이 저장한 메시지는 남고, 다음 실행은 사용자 메시지를 저장한 뒤 짝이 없는 tool.call 부분만 제거한 대화로 conversation 단계를 실행한다.",
  "spec": [
    "실패한 실행과 대화"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "k-1",
                "name": "keep",
                "args": {}
              },
              {
                "callId": "f-1",
                "name": "fail",
                "args": {}
              }
            ]
          },
          {
            "text": "완료"
          }
        ]
      }
    },
    "tools": {
      "keep": {
        "description": "보관",
        "results": [
          {
            "text": "보관"
          }
        ]
      },
      "fail": {
        "description": "실패",
        "results": [
          {
            "error": "도구 실패"
          }
        ]
      }
    },
    "functions": {
      "tap": {
        "op": "constant",
        "value": null
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "요청"
      }
    },
    {
      "run": {
        "conversationId": "c1",
        "input": "다시"
      }
    }
  ]
}
