{
  "description": "실행이 중단되면 진행 중이던 모델 호출은 codes가 aborted인 step.error를, 중단된 에이전트 실행은 같은 codes의 turn.error를 알린다.",
  "spec": [
    "이벤트 순서"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "await": "never",
            "then": {
              "text": "늦은 응답"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "시작"
            }
          }
        ],
        [
          {
            "reach": "never"
          },
          {
            "abort": {
              "conversationId": "c1"
            }
          }
        ]
      ]
    }
  ]
}
