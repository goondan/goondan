{
  "description": "이벤트는 호스트의 이벤트 수신 기능에 먼저 전달하고, 그 실행 범위에서 같은 이름의 처리기를 제공한 확장 인스턴스에만 인스턴스를 만든 순서대로 전달한다.",
  "spec": [
    "실행 이벤트",
    "이벤트 형식과 전달"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "답변",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "alpha": {
        "instance": {
          "events": [
            "turn.done"
          ]
        }
      },
      "beta": {
        "instance": {
          "events": []
        }
      },
      "gamma": {
        "instance": {
          "events": [
            "turn.done",
            "step.start"
          ]
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "질문"
      }
    }
  ]
}
