{
  "description": "확장 생성이 실패하면 흐름 단계의 에이전트 실행은 runtime_error로 실패하고 input과 error 단계 훅을 실행하지 않으며, 이미 만든 인스턴스를 만든 순서대로 정리하고 같은 범위의 다음 실행은 준비를 처음부터 다시 한다.",
  "spec": [
    "확장 인스턴스"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": []
      }
    },
    "functions": {
      "mark": {
        "op": "identity"
      },
      "markErr": {
        "op": "identity"
      }
    },
    "extensions": {
      "alpha": {},
      "beta": {
        "definition": {
          "createError": "확장을 만들 수 없다"
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    },
    {
      "run": {
        "sessionId": "c1",
        "input": "다시"
      }
    }
  ]
}
