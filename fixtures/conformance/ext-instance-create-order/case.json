{
  "description": "인스턴스는 유효 구성의 extensions 선언 순서대로 만들고, 확장마다 옵션 검증 함수를 먼저 호출해 반환값을 생성 입력의 options로 쓰며 반환값이 null이면 원래 options를 쓴다.",
  "spec": [
    "확장 인스턴스"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "zeta": {
        "definition": {
          "validateOptions": {
            "op": "merge",
            "value": {
              "checked": true
            }
          }
        }
      },
      "alpha": {
        "definition": {
          "validateOptions": {
            "op": "constant",
            "value": null
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
