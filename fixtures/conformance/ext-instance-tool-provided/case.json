{
  "description": "활성화된 확장이 제공하는 도구는 tools 목록에 이름이 있을 때 도구 정의로 모델에 전달되고, 호출되면 인스턴스의 도구 구현이 실행되어 결과가 대화에 저장된다.",
  "spec": [
    "확장",
    "확장 인스턴스"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "r-1",
                "name": "recall",
                "args": {
                  "q": "이름"
                }
              }
            ],
            "usage": {
              "input": 2,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 3,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "definition": {
          "tools": [
            "recall"
          ]
        },
        "instance": {
          "tools": {
            "recall": {
              "description": "기억 조회",
              "results": [
                {
                  "text": "없음"
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
