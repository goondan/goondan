{
  "description": "carry.conversation asis는 다음 에이전트의 저장된 대화를 전달한 복사본으로 교체하며, 다음 에이전트가 대화를 바꿔도 직전 에이전트의 저장된 대화는 바뀌지 않는다.",
  "spec": [
    "route 함수와 `carry`"
  ],
  "bindings": {
    "models": {
      "mf": {
        "responses": [
          {
            "text": "정리1",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "정리2",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "ms": {
        "responses": [
          {
            "text": "요약1",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "요약2",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "1차"
      }
    },
    {
      "run": {
        "conversationId": "c1",
        "input": "2차"
      }
    }
  ]
}
