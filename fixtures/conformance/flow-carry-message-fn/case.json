{
  "description": "carry.message의 함수는 output, input, conversation을 담은 객체를 받고, 반환한 JSON 값이 다음 에이전트의 입력이 된다.",
  "spec": [
    "route 함수와 `carry`"
  ],
  "bindings": {
    "models": {
      "mf": {
        "responses": [
          {
            "text": "정리본",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "ms": {
        "responses": [
          {
            "text": "최종본",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "build": {
        "op": "chain",
        "ops": [
          {
            "op": "get",
            "path": "/output"
          },
          {
            "op": "wrap",
            "key": "text"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "원문"
      }
    }
  ]
}
