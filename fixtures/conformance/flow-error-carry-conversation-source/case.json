{
  "description": "carry.conversation 함수가 돌려준 항목에 source가 없으면 메시지 정의를 만족하지 않으므로 다음 에이전트를 실행하기 전에 흐름 오류로 실패한다.",
  "spec": [
    "route 함수와 `carry`",
    "단계 값과 대화 저장"
  ],
  "bindings": {
    "models": {
      "mf": {
        "responses": [
          {
            "text": "정리본",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "ms": {
        "responses": []
      }
    },
    "functions": {
      "seed": {
        "op": "constant",
        "value": [
          {
            "id": "seed-1",
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "이전 요약"
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "원문"
      }
    }
  ]
}
