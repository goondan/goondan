{
  "description": "배열형 흐름은 첫 에이전트가 원래 입력을 받고 각 에이전트의 출력 텍스트가 다음 에이전트의 입력이 되며, 마지막 에이전트의 출력만 최종 출력으로 반환한다.",
  "spec": [
    "흐름",
    "출력 텍스트",
    "턴 결과"
  ],
  "bindings": {
    "models": {
      "mf": {
        "responses": [
          {
            "text": "정리본",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "ms": {
        "responses": [
          {
            "text": "최종본",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "원문"
      }
    }
  ]
}
