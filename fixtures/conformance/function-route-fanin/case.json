{
  "description": "겹쳐 실행되는 함수 route는 turn 범위 routeCall로 시작과 종료를 짝지으며, 결과는 route 순서로 합류한다.",
  "spec": [
    "route 진행",
    "입력 대기열과 턴",
    "실행 결과"
  ],
  "config": {
    "document": {
      "agents": {
        "main": {
          "model": "m"
        }
      },
      "routes": [
        {"from": "$input", "to": {"fn": "left"}},
        {"from": "$input", "to": {"fn": "right"}},
        {"from": {"fn": "left"}, "to": "main"},
        {"from": {"fn": "right"}, "to": "main"},
        {"from": "main", "to": "$output"}
      ]
    }
  },
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {"text": "합류 완료"}
        ]
      }
    },
    "functions": {
      "left": {
        "op": "await",
        "gate": "left",
        "then": {
          "op": "constant",
          "value": [
            {
              "id": "left-message",
              "role": "assistant",
              "source": "left",
              "content": [{"type": "text", "text": "왼쪽"}]
            }
          ]
        }
      },
      "right": {
        "op": "await",
        "gate": "right",
        "then": {
          "op": "constant",
          "value": [
            {
              "id": "right-message",
              "role": "system",
              "source": "right",
              "content": [{"type": "text", "text": "오른쪽"}]
            }
          ]
        }
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "fanin",
              "input": "시작"
            }
          }
        ],
        [
          {"reach": "left"},
          {"reach": "right"},
          {"release": "left"},
          {"release": "right"}
        ]
      ]
    }
  ]
}
