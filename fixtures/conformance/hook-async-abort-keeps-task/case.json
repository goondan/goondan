{
  "description": "호스트의 실행 중단 요청은 비동기 작업을 중단하지 않으므로, 중단된 턴이 예약한 작업의 결과도 같은 실행 범위의 다음 안전한 대화 처리 지점에서 대화에 반영된다.",
  "spec": [
    "비동기 훅",
    "실행 중단"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "await": "m1",
            "then": {
              "text": "답1",
              "usage": {
                "input": 1,
                "output": 1
              }
            }
          },
          {
            "text": "답2",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "asyncNote": {
        "op": "await",
        "gate": "g",
        "then": {
          "op": "constant",
          "value": "비동기"
        }
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "c1",
              "input": "첫"
            }
          }
        ],
        [
          {
            "reach": "m1"
          },
          {
            "abort": {
              "sessionId": "c1"
            }
          }
        ]
      ],
      "settle": false
    },
    {
      "release": "g"
    },
    {
      "run": {
        "sessionId": "c1",
        "input": "둘"
      }
    }
  ]
}
