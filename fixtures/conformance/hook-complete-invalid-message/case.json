{
  "description": "인수가 문자열 id와 source를 가진 assistant 메시지가 아니면 아무것도 예약하지 않고 오류를 던지므로 필수 훅은 toolResult 단계의 hook_error로 실행을 실패시킨다.",
  "spec": [
    "`execution.complete`"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "lookup",
                "args": {}
              }
            ],
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": [
          {
            "text": "결과"
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "toolResult": {
              "op": "complete",
              "message": {
                "role": "assistant",
                "content": [
                  {
                    "type": "text",
                    "text": "마무리"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
