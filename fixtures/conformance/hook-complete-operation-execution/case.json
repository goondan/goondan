{
  "description": "승인된 작업을 실행할 때의 toolResult 훅에는 끝낼 에이전트 실행이 없으므로, 조건을 만족한 execution.complete 호출은 아무 효과가 없고 작업의 결과와 완료 전달도 바꾸지 않는다.",
  "spec": [
    "`execution.complete`",
    "승인된 작업의 실행"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "p-1",
                "name": "publish",
                "args": {
                  "doc": "초안"
                }
              }
            ],
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "publish": {
        "results": [
          {
            "text": "게시됨"
          }
        ]
      }
    },
    "host": {
      "deliverOperationCompletion": true
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "toolResult": {
              "op": "complete",
              "message": {
                "id": "done-1",
                "role": "assistant",
                "source": "memo",
                "content": [
                  {
                    "type": "text",
                    "text": "마무리"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    },
    {
      "decide": {
        "operation": "<op:p-1>",
        "value": {
          "decision": "approved"
        }
      }
    }
  ]
}
