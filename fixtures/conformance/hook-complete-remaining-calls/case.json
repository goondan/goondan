{
  "description": "예약이 이루어진 모델 응답의 나머지 호출은 평소와 같이 처리해 각 도구 결과를 대화에 저장한 뒤 예약된 메시지로 실행을 끝낸다.",
  "spec": [
    "`execution.complete`"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "a-1",
                "name": "first",
                "args": {}
              },
              {
                "callId": "b-1",
                "name": "second",
                "args": {}
              }
            ],
            "usage": {
              "input": 5,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "first": {
        "results": [
          {
            "text": "하나"
          }
        ]
      },
      "second": {
        "results": [
          {
            "text": "둘"
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "toolResult": {
              "op": "complete",
              "tool": "first",
              "message": {
                "id": "done-1",
                "role": "assistant",
                "source": "memo",
                "content": [
                  {
                    "type": "text",
                    "text": "마무리"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
