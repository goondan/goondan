{
  "description": "동기 onToolResult 확장 훅의 complete 결과는 모델을 다시 호출하지 않고 예약한 메시지로 실행을 끝내며, 결과를 대화 끝에 저장하고 실행의 finishReason은 tool이다.",
  "spec": [
    "제어 결과",
    "단계 값과 대화 저장"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "lookup",
                "args": {}
              }
            ],
            "usage": {
              "input": 5,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": [
          {
            "text": "결과"
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "onToolResult": {
              "op": "complete",
              "message": {
                "id": "done-1",
                "role": "assistant",
                "source": "memo",
                "content": [
                  {
                    "type": "text",
                    "text": "마무리"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
