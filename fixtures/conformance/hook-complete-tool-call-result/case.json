{
  "description": "toolCall 훅이 반환한 도구 결과를 처리하는 toolResult 훅이 예약해도 같은 규칙을 적용하므로, 도구를 실행하지 않은 채 예약된 메시지로 실행이 끝난다.",
  "spec": [
    "`execution.complete`",
    "제어 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "lookup",
                "args": {}
              }
            ],
            "usage": {
              "input": 4,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": []
      }
    },
    "functions": {
      "giveResult": {
        "op": "result",
        "content": [
          {
            "type": "text",
            "text": "대체"
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "toolResult": {
              "op": "complete",
              "message": {
                "id": "done-1",
                "role": "assistant",
                "source": "memo",
                "content": [
                  {
                    "type": "text",
                    "text": "마무리"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
