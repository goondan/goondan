{
  "description": "같은 에이전트 실행에 이미 예약된 메시지가 있으면 다음 호출은 오류를 던지며 실행이 실패하면 예약된 메시지는 사용하지 않는다.",
  "spec": [
    "제어 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "lookup",
                "args": {}
              }
            ],
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": [
          {
            "text": "결과"
          }
        ]
      }
    },
    "extensions": {
      "alpha": {
        "instance": {
          "hooks": {
            "onToolResult": {
              "op": "complete",
              "message": {
                "id": "done-1",
                "role": "assistant",
                "source": "memo",
                "content": [
                  {
                    "type": "text",
                    "text": "마무리"
                  }
                ]
              }
            }
          }
        }
      },
      "beta": {
        "instance": {
          "hooks": {
            "onToolResult": {
              "op": "complete",
              "message": {
                "id": "done-2",
                "role": "assistant",
                "source": "beta",
                "content": [
                  {
                    "type": "text",
                    "text": "다시"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
