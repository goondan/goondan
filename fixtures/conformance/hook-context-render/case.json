{
  "description": "훅 컨텍스트의 render는 이미 읽은 템플릿을 전달한 변수로 렌더링한 문자열을 반환한다.",
  "spec": [
    "실행 컨텍스트와 호스트 함수"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "onInput": {
              "op": "chain",
              "ops": [
                {
                  "op": "render",
                  "template": "templates/greet.md",
                  "variables": {
                    "agent": {
                      "name": "군단"
                    }
                  }
                },
                {
                  "op": "constant",
                  "value": [
                    {
                      "id": "rendered",
                      "role": "user",
                      "source": "main",
                      "content": [
                        {
                          "type": "text",
                          "text": "안녕 군단"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
