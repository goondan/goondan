{
  "description": "훅 컨텍스트의 retryCount는 현재 에이전트 실행에서 이미 따른 재시도 횟수이므로 modelResult 재시도를 한 번 따른 뒤의 modelInput 훅은 1을 받는다.",
  "spec": [
    "훅 컨텍스트와 호스트 함수",
    "제어 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "첫",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "둘",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "retryOnce": {
        "op": "sequence",
        "items": [
          {
            "op": "constant",
            "value": {
              "retry": true,
              "target": "model"
            }
          },
          {
            "op": "constant",
            "value": null
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "modelInput": {
              "op": "identity"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
