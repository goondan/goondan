{
  "description": "append 제어 결과는 현재 메시지 목록 끝에 메시지를 추가하고 같은 단계의 다음 훅을 계속 실행하며, 훅 컨텍스트가 만든 메시지의 source는 훅 식별자이고 지정한 key와 keep과 meta만 갖는다.",
  "spec": [
    "제어 결과",
    "훅 컨텍스트와 호스트 함수"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "mark": {
        "op": "constant",
        "value": "다음"
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "conversation": {
              "op": "append",
              "messages": [
                {
                  "role": "system",
                  "text": "규칙"
                }
              ]
            },
            "modelInput": {
              "op": "append",
              "messages": [
                {
                  "role": "user",
                  "text": "추가",
                  "keep": true,
                  "meta": {
                    "tag": "x"
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
