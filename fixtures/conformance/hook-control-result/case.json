{
  "description": "toolCall 훅이 도구 결과를 반환하면 도구를 실행하지 않고 호출 가능 여부도 확인하지 않으며 같은 단계의 나머지 훅을 실행하지 않고 그 결과로 toolResult 단계를 실행한다.",
  "spec": [
    "제어 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "g-1",
                "name": "ghost",
                "args": {}
              }
            ],
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": []
      }
    },
    "functions": {
      "giveResult": {
        "op": "result",
        "content": [
          {
            "type": "text",
            "text": "대체"
          }
        ]
      },
      "mark": {
        "op": "identity"
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
