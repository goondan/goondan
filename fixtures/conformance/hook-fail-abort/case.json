{
  "description": "호스트의 실행 중단으로 훅이 끝나는 것은 훅 실패가 아니므로 hook.failed를 알리지 않고 선택 훅이어도 무시하지 않으며 에이전트 실행을 aborted로 실패시킨다.",
  "spec": [
    "훅 실패",
    "실행 중단"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": []
      }
    },
    "extensions": {
      "slow": {
        "instance": {
          "hooks": {
            "onStep": {
              "op": "await",
              "gate": "never",
              "then": {
                "op": "identity"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "c1",
              "input": "안녕"
            }
          }
        ],
        [
          {
            "reach": "never"
          },
          {
            "abort": {
              "sessionId": "c1"
            }
          }
        ]
      ]
    }
  ]
}
