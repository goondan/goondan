{
  "description": "실패한 훅이 그 전에 시작한 하위 실행은 되돌리지 않으며 턴의 에이전트 실행 기록에 남는다.",
  "spec": [
    "훅 실패",
    "훅 컨텍스트와 호스트 함수",
    "에이전트 실행 기록"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      },
      "h": {
        "responses": [
          {
            "text": "도움",
            "usage": {
              "input": 3,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "modelInput": {
              "op": "chain",
              "ops": [
                {
                  "op": "runAgent",
                  "name": "helper",
                  "input": "부탁"
                },
                {
                  "op": "throw",
                  "message": "훅 실패"
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
