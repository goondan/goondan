{
  "description": "재시도 한도에 이미 도달한 실행에서 modelResult 훅이 재시도를 요청하면 그 훅은 실패하므로, 필수 훅이면 modelResult 단계의 hook_error로 실행이 실패하고 선택 훅이면 훅을 실행하기 전의 값으로 계속한다.",
  "spec": [
    "훅 실패",
    "재시도"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "첫",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "둘",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "askRetry": {
        "op": "constant",
        "value": {
          "retry": true,
          "target": "model"
        }
      }
    },
    "maxRetries": 0
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕",
        "agent": "strict"
      }
    },
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕",
        "agent": "lenient"
      }
    }
  ]
}
