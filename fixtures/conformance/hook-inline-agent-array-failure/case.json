{
  "description": "agent 배열의 앞선 대상이 보통의 실행 오류로 실패해도 현재 에이전트 실행에 중단이 알려졌으면 훅 실패는 aborted로 보고한다.",
  "spec": [
    "인라인 훅",
    "실행 중단"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "ma": {
        "responses": [
          {
            "error": "알파 실패"
          }
        ]
      },
      "mb": {
        "responses": [
          {
            "await": "hold",
            "then": {
              "text": "베타"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "질문"
            }
          }
        ],
        [
          {
            "reach": "hold"
          },
          {
            "abort": {
              "conversationId": "c1"
            }
          },
          {
            "release": "hold"
          }
        ]
      ]
    }
  ]
}
