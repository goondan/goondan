{
  "description": "agent 배열의 두 대상이 모두 실패하면 뒤 대상이 먼저 실패했더라도 선언 순서에서 가장 앞선 대상의 실행 오류를 훅의 실패로 삼는다.",
  "spec": [
    "인라인 훅",
    "모델 실패"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "ma": {
        "responses": [
          {
            "await": "go",
            "then": {
              "error": "앞선 대상의 오류"
            }
          }
        ]
      },
      "mb": {
        "responses": [
          {
            "error": "뒤 대상의 오류"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "질문"
            }
          }
        ],
        [
          {
            "reach": "go"
          },
          {
            "release": "go"
          }
        ]
      ]
    }
  ]
}
