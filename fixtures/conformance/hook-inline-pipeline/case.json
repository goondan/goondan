{
  "description": "인라인 훅은 받은 값을 fn, agent, template 순서로 변환하며 template에는 직전 값인 text, 에이전트 입력인 input, 에이전트의 유효 params가 제공된다.",
  "spec": [
    "인라인 훅",
    "훅 식별자"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "h": {
        "responses": [
          {
            "text": "정리됨",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "toTask": {
        "op": "wrap",
        "key": "task"
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
