{
  "description": "JSON 값 비교는 수를 수치로 비교하므로 1.0과 1은 같고 불리언과 수는 서로 다른 종류이므로 같지 않다.",
  "spec": [
    "JSON 값 비교",
    "훅 실행과 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "답1",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "답2",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "makeNote": {
        "op": "constant",
        "value": "메모"
      },
      "isOne": {
        "op": "equals",
        "path": "/0/content/0/text",
        "value": "{\"n\":1}"
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": {
          "n": 1
        }
      }
    },
    {
      "run": {
        "sessionId": "c1",
        "input": {
          "n": true
        }
      }
    }
  ]
}
