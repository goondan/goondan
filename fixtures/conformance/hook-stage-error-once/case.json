{
  "description": "모델 호출 실패는 error 단계를 한 번 실행하고 그 처음 값은 실패한 호출의 실행 오류이며, 훅이 현재 값을 바꾸어도 재시도 요청이 아니면 에이전트 실행은 원래 실패의 where와 codes로 실패한다.",
  "spec": [
    "단계 실행 순서",
    "실행 오류"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "error": "모델이 멈췄다",
            "code": "overloaded"
          }
        ]
      }
    },
    "functions": {
      "recordError": {
        "op": "constant",
        "value": {
          "note": "무시"
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
