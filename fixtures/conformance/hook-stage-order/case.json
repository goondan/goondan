{
  "description": "모델 에이전트 실행은 input, conversation, modelInput, modelResult, toolCall, toolResult 순서로 단계를 실행하고 도구 호출을 모두 처리한 뒤 모델을 다시 호출하며 output으로 끝나고, conversation 단계는 실행마다 한 번만 실행하고 실패가 없으면 error 단계를 실행하지 않는다.",
  "spec": [
    "값 처리 단계와 훅",
    "단계 실행 순서",
    "훅 실행과 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "lookup",
                "args": {
                  "q": "군단"
                }
              }
            ],
            "usage": {
              "input": 5,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 8,
              "output": 2
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": [
          {
            "text": "결과"
          }
        ]
      }
    },
    "functions": {
      "hInput": {
        "op": "constant",
        "value": null
      },
      "hConversation": {
        "op": "constant",
        "value": null
      },
      "hModelInput": {
        "op": "constant",
        "value": null
      },
      "hModelResult": {
        "op": "constant",
        "value": null
      },
      "hToolCall": {
        "op": "constant",
        "value": null
      },
      "hToolResult": {
        "op": "constant",
        "value": null
      },
      "hOutput": {
        "op": "constant",
        "value": null
      },
      "hError": {
        "op": "constant",
        "value": null
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
