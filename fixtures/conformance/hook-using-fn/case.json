{
  "description": "using이 {fn: 이름}이면 현재 값을 그 함수에 전달해 받은 반환값이 훅이 받는 값이 된다.",
  "spec": [
    "훅 실행과 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "pick": {
        "op": "get",
        "path": "/0/content/0/value/requestId"
      },
      "shout": {
        "op": "constant",
        "value": [
          {
            "id": "picked",
            "role": "user",
            "source": "pickId",
            "content": [{"type": "text", "text": "req-1!"}]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": {
          "requestId": "req-1"
        }
      }
    }
  ]
}
