{
  "description": "input 단계 훅은 훅을 적용하기 전의 턴 입력을 받고, 이후 단계에서 using이 input인 훅은 input 단계 훅을 모두 적용한 에이전트 입력을 받는다.",
  "spec": [
    "훅 실행과 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "normalize": {
        "op": "set",
        "path": "/0/content/0/value/requestId",
        "value": "req-2"
      },
      "showInput": {
        "op": "constant",
        "value": "req-2"
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": {
          "text": "안녕",
          "requestId": "req-1"
        }
      }
    }
  ]
}
