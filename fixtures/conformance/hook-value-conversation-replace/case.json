{
  "description": "conversation 단계를 마친 값이 저장된 대화가 되므로 훅이 메시지 배열로 현재 값을 대신하면 저장된 대화 전체가 그 배열로 바뀐다.",
  "spec": [
    "단계 값과 대화 저장",
    "훅 실행과 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "첫",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "둘",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "compact": {
        "instance": {
          "hooks": {
            "onStep": {
              "op": "sequence",
              "items": [
                {
                  "op": "identity"
                },
                {
                  "op": "constant",
                  "value": [
                    {
                      "id": "s-1",
                      "role": "system",
                      "source": "compact",
                      "content": [
                        {
                          "type": "text",
                          "text": "요약"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    },
    {
      "run": {
        "sessionId": "c1",
        "input": "다시"
      }
    }
  ]
}
