{
  "description": "도구 결과는 toolResult 단계를 마친 뒤 role이 tool이고 source가 tool인 메시지로 저장하며, tool.result 부분은 callId와 content와 값이 있을 때의 isError를 가지고 도구 결과의 keep과 meta는 메시지의 값이 된다.",
  "spec": [
    "단계 값과 대화 저장"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "lookup",
                "args": {
                  "q": "군단"
                }
              }
            ],
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "lookup": {
        "results": [
          {
            "text": "결과",
            "isError": true,
            "keep": true,
            "meta": {
              "fixture": true
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
