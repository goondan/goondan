{
  "description": "when 함수가 true를 반환하면 훅을 실행하고 false를 반환하면 훅을 건너뛰며 hook.skipped 이벤트를 발생시킨다.",
  "spec": [
    "훅 실행과 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "첫",
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "둘",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "makeNote": {
        "op": "constant",
        "value": "메모"
      },
      "shouldRun": {
        "op": "sequence",
        "items": [
          {
            "op": "constant",
            "value": true
          },
          {
            "op": "constant",
            "value": false
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    },
    {
      "run": {
        "sessionId": "c1",
        "input": "다시"
      }
    }
  ]
}
