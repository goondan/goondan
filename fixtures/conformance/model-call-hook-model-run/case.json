{
  "description": "훅 컨텍스트의 model.run은 요청한 실행 식별자를 유지하며, 에이전트 루프를 호출하기 전에는 step 0을 사용하고 이후에는 현재 step을 사용한다.",
  "spec": [
    "모델 호출"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "사전 응답"
          },
          {
            "text": "본문 응답"
          },
          {
            "text": "사후 응답"
          }
        ]
      }
    },
    "extensions": {
      "probe": {
        "definition": {
          "hooks": [
            "onStep",
            "onOutput"
          ]
        },
        "instance": {
          "hooks": {
            "onStep": {
              "op": "runModel",
              "messages": [
                {
                  "id": "h-1",
                  "role": "user",
                  "source": "probe",
                  "content": [
                    {
                      "type": "text",
                      "text": "사전 확인"
                    }
                  ]
                }
              ]
            },
            "onOutput": {
              "op": "runModel",
              "messages": [
                {
                  "id": "h-2",
                  "role": "user",
                  "source": "probe",
                  "content": [
                    {
                      "type": "text",
                      "text": "사후 확인"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
