{
  "description": "훅 컨텍스트의 model.run은 같은 실행 컨텍스트를 사용하며 에이전트 실행의 모델 호출 번호를 증가시키지 않는다.",
  "spec": [
    "모델 호출"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "훅 응답"
          },
          {
            "text": "본문 응답"
          }
        ]
      }
    },
    "extensions": {
      "probe": {
        "definition": {
          "hooks": [
            "onStep"
          ]
        },
        "instance": {
          "hooks": {
            "onStep": {
              "op": "runModel",
              "messages": [
                {
                  "id": "h-1",
                  "role": "user",
                  "source": "probe",
                  "content": [
                    {
                      "type": "text",
                      "text": "사전 확인"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
