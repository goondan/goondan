{
  "description": "모델 호출 수 상한은 에이전트 실행이 직접 시작한 모델 호출에만 적용하므로 훅 컨텍스트의 model.run 호출은 상한에 세지 않는다.",
  "spec": [
    "모델 호출"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "훅 응답"
          },
          {
            "text": "본문 응답"
          }
        ]
      }
    },
    "extensions": {
      "probe": {
        "definition": {
          "hooks": [
            "conversation"
          ]
        },
        "instance": {
          "hooks": {
            "conversation": {
              "op": "runModel",
              "messages": [
                {
                  "id": "h-1",
                  "role": "user",
                  "source": "probe",
                  "content": [
                    {
                      "type": "text",
                      "text": "사전 확인"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "maxSteps": 1
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
