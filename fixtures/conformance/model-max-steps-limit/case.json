{
  "description": "maxSteps만큼 모델을 호출한 실행이 모델을 다시 호출해야 하면 modelInput 단계를 처리하지 않고 모델도 호출하지 않으며, error 단계를 거치지 않는 runtime 위치의 runtime_error로 실패한다.",
  "spec": [
    "모델 호출"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "e-1",
                "name": "echo",
                "args": {}
              }
            ]
          }
        ]
      }
    },
    "tools": {
      "echo": {
        "description": "되돌려 준다",
        "results": [
          {
            "text": "메아리"
          }
        ]
      }
    },
    "functions": {
      "markInput": {
        "op": "constant",
        "value": "표시"
      },
      "captureError": {
        "op": "identity"
      }
    },
    "maxSteps": 1
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
