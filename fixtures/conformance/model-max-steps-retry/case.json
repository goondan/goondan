{
  "description": "모델 호출 수 상한은 재시도로 다시 호출하는 횟수도 포함하므로, 재시도로 상한을 채운 실행은 다음 모델 호출에서 runtime_error로 실패한다.",
  "spec": [
    "모델 호출"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "첫 응답"
          },
          {
            "toolCalls": [
              {
                "callId": "e-1",
                "name": "echo",
                "args": {}
              }
            ]
          }
        ]
      }
    },
    "tools": {
      "echo": {
        "description": "되돌려 준다",
        "results": [
          {
            "text": "메아리"
          }
        ]
      }
    },
    "functions": {
      "retryOnce": {
        "op": "sequence",
        "items": [
          {
            "op": "constant",
            "value": {
              "retry": true,
              "target": "model"
            }
          },
          {
            "op": "identity"
          }
        ]
      }
    },
    "maxSteps": 2
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
