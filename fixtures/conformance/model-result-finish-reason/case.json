{
  "description": "런타임은 도구 실행 여부를 결과 메시지의 tool.call 부분으로 정하므로 finishReason이 stop이어도 도구를 실행하고 tool이어도 tool.call 부분이 없으면 output 단계로 진행한다.",
  "spec": [
    "모델 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "content": [
              {
                "type": "tool.call",
                "callId": "e-1",
                "name": "echo",
                "args": {}
              }
            ],
            "finishReason": "stop"
          },
          {
            "text": "끝",
            "finishReason": "tool"
          }
        ]
      }
    },
    "tools": {
      "echo": {
        "description": "되돌려 준다",
        "results": [
          {
            "text": "메아리"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "안녕"
      }
    }
  ]
}
