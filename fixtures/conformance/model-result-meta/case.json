{
  "description": "런타임은 모델 결과 메시지의 meta를 그대로 저장하고 이후 모델 입력에 같은 값으로 전달한다.",
  "spec": [
    "모델 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "content": [
              {
                "type": "text",
                "text": "첫 응답"
              }
            ],
            "meta": {
              "anthropic": {
                "signature": "sig-1"
              }
            }
          },
          {
            "text": "둘째 응답"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "첫 질문"
      }
    },
    {
      "run": {
        "sessionId": "c1",
        "input": "둘째 질문"
      }
    }
  ]
}
