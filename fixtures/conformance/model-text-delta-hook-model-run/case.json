{
  "description": "훅 컨텍스트의 model.run 호출도 source가 hook인 step 이벤트와 텍스트 조각을 내보내며, usage가 보고된 호출에만 usage를 싣는다.",
  "spec": [
    "텍스트 조각"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "숨김 응답",
            "deltas": [
              "숨",
              "김"
            ]
          },
          {
            "text": "보임 응답",
            "deltas": [
              "보임"
            ],
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "probe": {
        "definition": {
          "hooks": [
            "onStep"
          ]
        },
        "instance": {
          "hooks": {
            "onStep": {
              "op": "runModel",
              "messages": [
                {
                  "id": "h-1",
                  "role": "user",
                  "source": "probe",
                  "content": [
                    {
                      "type": "text",
                      "text": "사전 확인"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
