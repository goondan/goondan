{
  "description": "모델 구현이 전달한 텍스트 조각마다 그 호출의 step.start와 step.done 사이에서 받은 순서대로 step.textDelta 이벤트를 알린다.",
  "spec": [
    "텍스트 조각",
    "실행 이벤트"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "hello",
            "deltas": [
              "he",
              "llo"
            ],
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "안녕"
      }
    }
  ]
}
