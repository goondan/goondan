{
  "description": "실행 전 검증을 기다리는 approved 작업을 취소하면 cancelled가 되어 running으로 전이하지 못하므로 도구를 실행하지 않는다.",
  "spec": [
    "결정과 취소",
    "승인된 작업의 실행"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": []
      }
    },
    "host": {
      "validateOperation": {
        "op": "await",
        "gate": "hold",
        "then": {
          "op": "constant",
          "value": true
        }
      },
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      },
      "settle": false
    },
    {
      "reach": "hold"
    },
    {
      "cancel": {
        "operation": "<op:d-1>"
      },
      "settle": false
    },
    {
      "release": "hold"
    }
  ]
}
