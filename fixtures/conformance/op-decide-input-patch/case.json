{
  "description": "입력 수정을 허용한 승인은 원래 인수에 수정을 값 병합 규칙으로 병합한 resolvedToolCall을 기록하고 그 호출로 도구를 실행하며, 저장된 toolCall은 바뀌지 않는다.",
  "spec": [
    "결정과 취소",
    "승인된 작업의 실행",
    "작업 기록과 상태"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "p-1",
                "name": "danger",
                "args": {
                  "target": {
                    "id": 1,
                    "env": "prod"
                  },
                  "tags": [
                    "a"
                  ],
                  "note": "x"
                }
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "text": "실행 완료"
          }
        ]
      }
    },
    "host": {
      "validateOperationInputPatch": true,
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:p-1>",
        "value": {
          "decision": "approved",
          "inputPatch": {
            "target": {
              "env": "staging"
            },
            "tags": [
              "b"
            ]
          }
        }
      }
    }
  ]
}
