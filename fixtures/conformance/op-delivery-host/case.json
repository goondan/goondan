{
  "description": "호스트가 완료 전달을 제공하면 완료 입력으로 한 번 호출하고 반환과 함께 delivered로 확정하며, 이후 복구는 delivered 작업에 아무것도 하지 않는다.",
  "spec": [
    "완료 전달",
    "복구"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "text": "실행 완료"
          }
        ]
      }
    },
    "host": {
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      }
    },
    {
      "recover": {}
    }
  ]
}
