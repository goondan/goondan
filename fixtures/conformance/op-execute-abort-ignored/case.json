{
  "description": "호스트가 대화 식별자로 요청하는 실행 중단은 승인된 작업의 실행을 중단하지 않으므로, 도구 실행은 끝까지 진행되어 작업이 completed가 되고 완료가 전달된다.",
  "spec": [
    "승인된 작업의 실행",
    "실행 중단"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "await": "hold",
            "then": {
              "text": "실행 완료"
            }
          }
        ]
      }
    },
    "host": {
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      },
      "settle": false
    },
    {
      "reach": "hold"
    },
    {
      "abort": {
        "conversationId": "c1"
      },
      "settle": false
    },
    {
      "release": "hold"
    }
  ]
}
