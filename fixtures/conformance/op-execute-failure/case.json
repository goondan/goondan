{
  "description": "승인된 작업의 도구 실행이 실패하면 작업이 execution_failed로 기록되고 operationId를 담은 tool.error 이벤트가 발생하며, 결정 요청은 오류 없이 끝난다.",
  "spec": [
    "승인된 작업의 실행",
    "작업 기록과 상태",
    "완료 전달"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ],
            "usage": {
              "input": 2,
              "output": 1
            }
          },
          {
            "text": "대기합니다",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "error": "도구 폭발"
          }
        ]
      }
    },
    "host": {
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      }
    }
  ]
}
