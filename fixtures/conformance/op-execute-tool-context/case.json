{
  "description": "승인된 작업을 실행할 때 도구 컨텍스트의 input은 operation_execution이고 turnId와 execution은 작업의 값이며 toolCall은 toolCall 훅 처리를 마친 호출이다.",
  "spec": [
    "승인된 작업의 실행"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {
                  "value": 0
                }
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "text": "실행 완료"
          }
        ]
      }
    },
    "functions": {
      "withExecution": {
        "op": "constant",
        "value": {
          "call": {
            "id": "d-1",
            "name": "danger",
            "args": {
              "value": 1
            }
          },
          "execution": {
            "ticket": "T-1"
          }
        }
      }
    },
    "host": {
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      }
    }
  ]
}
