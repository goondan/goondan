{
  "description": "대기 중인 도구 결과는 toolResult 훅을 거치지 않고, 승인된 작업을 실행한 도구 결과에만 훅이 한 번 적용되어 작업의 result로 기록되며 대화에는 저장되지 않는다.",
  "spec": [
    "승인 작업 생성",
    "승인된 작업의 실행"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "text": "실행 완료"
          }
        ]
      }
    },
    "functions": {
      "addTag": {
        "op": "set",
        "path": "/content/-",
        "value": {
          "type": "text",
          "text": "검수 완료"
        }
      }
    },
    "host": {
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      }
    }
  ]
}
