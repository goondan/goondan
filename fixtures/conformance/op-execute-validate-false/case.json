{
  "description": "호스트 작업 검증이 true가 아닌 값을 반환하면 작업은 running을 거치지 않고 validation_failed로 실패하며 도구 이벤트도 알리지 않는다.",
  "spec": [
    "승인된 작업의 실행",
    "작업 기록과 상태",
    "완료 전달"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ],
            "usage": {
              "input": 2,
              "output": 1
            }
          },
          {
            "text": "대기합니다",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": []
      }
    },
    "host": {
      "validateOperation": {
        "op": "constant",
        "value": false
      },
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      }
    }
  ]
}
