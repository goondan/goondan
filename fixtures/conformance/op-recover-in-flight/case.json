{
  "description": "복구는 같은 런타임이 아직 실행하고 있는 작업을 중단된 것으로 처리하지 않으므로, running 작업은 그대로 진행해 completed가 되고 도구도 다시 실행하지 않는다.",
  "spec": [
    "복구",
    "승인된 작업의 실행"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ]
          },
          {
            "text": "대기합니다"
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "await": "hold",
            "then": {
              "text": "실행 완료"
            }
          }
        ]
      }
    },
    "host": {
      "deliverOperationCompletion": true
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "실행해 줘"
      }
    },
    {
      "decide": {
        "operation": "<op:d-1>",
        "value": {
          "decision": "approved"
        }
      },
      "settle": false
    },
    {
      "reach": "hold"
    },
    {
      "recover": {},
      "settle": false
    },
    {
      "release": "hold"
    }
  ]
}
