{
  "description": "operation.failed는 기존 작업 상태 필드와 함께 구조화된 실행 오류 cause를 저널에 보존하며 fold는 작업 상태를 같은 방식으로 산출한다.",
  "spec": ["저널 이벤트 종류", "작업 기록과 상태"],
  "config": {
    "document": {
      "agents": {
        "main": {"model": "m"}
      }
    }
  },
  "bindings": {
    "models": {
      "m": {"responses": []}
    }
  },
  "steps": [
    {
      "appendJournal": {
        "events": [
          {
            "version": 1,
            "type": "operation.created",
            "sessionId": "cause",
            "agent": "main",
            "instance": "cause/main",
            "turnId": "turn-fixed",
            "executionId": "execution-fixed",
            "operationId": "operation-fixed",
            "data": {
              "operation": {
                "operationId": "operation-fixed",
                "deliveryId": "operation:operation-fixed:completion",
                "agent": "main",
                "sessionId": "cause",
                "turnId": "turn-fixed",
                "instance": "cause/main",
                "executionId": "execution-fixed",
                "toolCall": {"id": "call-fixed", "name": "publish", "args": {}},
                "reasons": ["승인이 필요합니다."],
                "status": "pending",
                "deliveryStatus": "pending",
                "createdAt": 1,
                "updatedAt": 1
              }
            }
          },
          {
            "version": 1,
            "type": "operation.approved",
