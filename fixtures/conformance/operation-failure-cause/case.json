          {
            "version": 1,
            "type": "operation.failed",
            "sessionId": "cause",
            "agent": "main",
            "instance": "cause/main",
            "turnId": "turn-fixed",
            "executionId": "execution-fixed",
            "operationId": "operation-fixed",
            "data": {
              "updatedAt": 3,
              "error": "게시 작업이 실패했습니다.",
              "errorCode": "execution_failed",
              "cause": {
                "where": "tool",
                "codes": ["tool_error"],
                "message": "도구가 실패했습니다.",
                "attempt": 2,
                "toolCall": {"id": "call-fixed", "name": "publish", "args": {}}
              }
            }
          }
        ],
        "expected": 0,
        "writeId": "cause-write"
      },
      "settle": false
    }
  ]
}
