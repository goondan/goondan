{
  "description": "config 에이전트의 출력은 중첩 구성 턴 결과의 output이고 그 종료 사유도 중첩 턴의 값이며, config 에이전트 자신은 이벤트를 알리지 않는다.",
  "spec": [
    "턴 결과",
    "종료 사유",
    "에이전트 실행 기록",
    "이벤트 순서"
  ],
  "bindings": {
    "models": {
      "mi": {
        "responses": [
          {
            "text": "속 결과",
            "usage": {
              "input": 3,
              "output": 2
            },
            "finishReason": "length"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "질문"
      }
    }
  ]
}
