{
  "description": "훅 컨텍스트의 모델 호출이 실패하면 그 model 항목의 usage는 모두 0이고 status는 failed이며, 선택 훅이 실패한 턴은 계속 진행한다.",
  "spec": [
    "에이전트 실행 기록",
    "사용량 집계"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "error": "훅 모델 실패"
          },
          {
            "text": "완료",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "probe": {
        "definition": {
          "hooks": [
            "modelInput"
          ]
        },
        "instance": {
          "hooks": {
            "modelInput": {
              "op": "runModel",
              "messages": [
                {
                  "id": "probe-1",
                  "role": "user",
                  "source": "probe",
                  "content": [
                    {
                      "type": "text",
                      "text": "확인"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "질문"
      }
    }
  ]
}
