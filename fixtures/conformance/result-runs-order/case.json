{
  "description": "runs에는 route 실행, 에이전트 도구와 훅 에이전트 실행이 규격이 정한 순서로 들어가고 턴의 usage는 그 항목들의 합계다.",
  "spec": [
    "에이전트 실행 기록",
    "사용량 집계"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "w-1",
                "name": "worker",
                "args": {
                  "task": "정리"
                }
              }
            ],
            "usage": {
              "input": 1,
              "output": 1
            }
          },
          {
            "text": "본문",
            "usage": {
              "input": 1,
              "output": 1
            }
          }
        ]
      },
      "w": {
        "responses": [
          {
            "text": "작업",
            "usage": {
              "input": 100,
              "output": 0
            }
          }
        ]
      },
      "rv": {
        "responses": [
          {
            "text": "검토",
            "usage": {
              "input": 10,
              "output": 0
            }
          }
        ]
      },
      "ck": {
        "responses": [
          {
            "text": "점검",
            "usage": {
              "input": 20,
              "output": 0
            }
          }
        ]
      },
      "h": {
        "responses": [
          {
            "text": "도움",
            "usage": {
              "input": 1000,
              "output": 0
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "시작"
      }
    }
  ]
}
