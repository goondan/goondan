{
  "description": "존재하지 않는 에이전트를 요청해 시작하지 못한 실행은 runs 항목을 만들지 않는다.",
  "spec": [
    "에이전트 실행 기록"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "본문",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "probe": {
        "definition": {
          "hooks": [
            "onOutput"
          ]
        },
        "instance": {
          "hooks": {
            "onOutput": {
              "op": "runAgent",
              "name": "ghost"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "질문"
      }
    }
  ]
}
