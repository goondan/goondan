{
  "description": "런타임은 modelResult 훅을 적용하기 전에 사용량을 집계하므로, 훅이 응답 재시도를 요청해도 이미 받은 응답의 사용량이 집계에 남는다.",
  "spec": [
    "사용량 집계"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "초안",
            "usage": {
              "input": 5,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 7,
              "output": 2
            }
          }
        ]
      }
    },
    "functions": {
      "retryOnce": {
        "op": "sequence",
        "items": [
          {
            "op": "constant",
            "value": {
              "retry": true,
              "target": "model"
            }
          },
          {
            "op": "identity"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "질문"
      }
    }
  ]
}
