{
  "description": "aborted 오류는 where가 runtime이므로 error 단계를 거치지 않는다.",
  "spec": [
    "재시도",
    "실행 중단"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "await": "never",
            "then": {
              "text": "늦은 응답"
            }
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onError": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "model"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "c1",
              "input": "요청"
            }
          }
        ],
        [
          {
            "reach": "never"
          },
          {
            "abort": {
              "sessionId": "c1"
            }
          }
        ]
      ]
    }
  ]
}
