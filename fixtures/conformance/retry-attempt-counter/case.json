{
  "description": "동시에 시작한 도구 호출의 실행 오류 attempt는 각 호출을 시작할 때 정해진 값을 유지한다.",
  "spec": [
    "재시도",
    "실행 오류"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "a",
                "args": {}
              },
              {
                "callId": "c-2",
                "name": "b",
                "args": {}
              },
              {
                "callId": "c-3",
                "name": "c",
                "args": {}
              }
            ]
          }
        ]
      }
    },
    "tools": {
      "a": {
        "results": [
          {
            "text": "A"
          }
        ]
      },
      "b": {
        "results": [
          {
            "error": "b 실패"
          },
          {
            "text": "B"
          }
        ]
      },
      "c": {
        "results": [
          {
            "error": "c 실패"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onError": {
              "op": "sequence",
              "items": [
                {
                  "op": "constant",
                  "value": {
                    "retry": true,
                    "target": "tool",
                    "afterMs": 20
                  }
                },
                {
                  "op": "identity"
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
