{
  "description": "승인 요청 전달이 실패한 호출은 대기 중인 도구 결과를 이미 저장했으므로 target tool 재시도 요청을 따르지 않는다.",
  "spec": [
    "재시도",
    "승인 작업 생성"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "d-1",
                "name": "danger",
                "args": {}
              }
            ]
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": []
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "error": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "tool"
              }
            }
          }
        }
      }
    },
    "host": {
      "requestApproval": {
        "op": "throw",
        "message": "승인 요청 실패"
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
