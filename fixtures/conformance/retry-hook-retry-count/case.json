{
  "description": "훅 컨텍스트의 retryCount는 그 시점까지 따른 재시도 횟수이므로 modelResult 재시도를 한 번 따른 뒤의 훅은 1을 받는다.",
  "spec": [
    "재시도",
    "훅 컨텍스트와 호스트 함수"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "초안"
          },
          {
            "text": "완료"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "modelInput": {
              "op": "identity"
            },
            "modelResult": {
              "op": "sequence",
              "items": [
                {
                  "op": "constant",
                  "value": {
                    "retry": true,
                    "target": "model"
                  }
                },
                {
                  "op": "identity"
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "요청"
      }
    }
  ]
}
