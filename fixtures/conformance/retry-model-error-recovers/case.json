{
  "description": "error 훅의 target model 재시도는 modelInput 단계부터 다시 실행하므로 사용자 메시지를 다시 저장하지 않고 conversation 단계도 다시 실행하지 않는다.",
  "spec": [
    "재시도",
    "단계 실행 순서"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "error": "일시 오류"
          },
          {
            "text": "완료",
            "usage": {
              "input": 3,
              "output": 1
            }
          }
        ]
      }
    },
    "functions": {
      "tap": {
        "op": "constant",
        "value": null
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "error": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "model"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
