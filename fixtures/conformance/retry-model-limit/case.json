{
  "description": "재시도 한도의 기본값은 3이므로 모델이 계속 실패하고 error 훅이 매번 재시도를 요청하면 모델은 네 번 호출되고 실행은 네 번째 실패로 끝난다.",
  "spec": [
    "재시도"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "error": "모델 실패"
          },
          {
            "error": "모델 실패"
          },
          {
            "error": "모델 실패"
          },
          {
            "error": "모델 실패"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "error": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "model"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "요청"
      }
    }
  ]
}
