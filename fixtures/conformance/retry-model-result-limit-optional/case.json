{
  "description": "재시도 한도에 도달한 modelResult 훅이 선택 훅이면 그 훅의 결과를 버리고 훅을 실행하기 전의 모델 결과로 실행을 계속한다.",
  "spec": [
    "재시도",
    "훅 실패"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "초안",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onModelResult": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "model"
              }
            }
          }
        }
      }
    },
    "maxRetries": 0
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
