{
  "description": "재시도 한도에 이미 도달한 실행에서 modelResult 훅이 재시도를 요청하면 그 훅이 실패하고, 필수 훅이므로 실행은 hook_error로 끝난다.",
  "spec": [
    "재시도",
    "훅 실패"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "초안",
            "usage": {
              "input": 2,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onModelResult": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "model"
              }
            }
          }
        }
      }
    },
    "maxRetries": 0
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
