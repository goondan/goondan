{
  "description": "modelResult 훅의 재시도 요청은 그 모델 결과의 메시지를 저장하지 않고 모델을 다시 호출하지만, 이미 받은 응답의 사용량은 집계에 남는다.",
  "spec": [
    "재시도",
    "사용량 집계"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "초안",
            "usage": {
              "input": 2,
              "output": 1
            }
          },
          {
            "text": "완료",
            "usage": {
              "input": 4,
              "output": 1
            }
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "modelResult": {
              "op": "sequence",
              "items": [
                {
                  "op": "constant",
                  "value": {
                    "retry": true,
                    "target": "model"
                  }
                },
                {
                  "op": "identity"
                }
              ]
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
