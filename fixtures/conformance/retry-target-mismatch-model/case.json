{
  "description": "도구 호출 실패에는 target이 tool인 재시도만 따르므로 target model 요청은 무시되고 원래 tool_error로 실패한다.",
  "spec": [
    "재시도"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "danger",
                "args": {}
              }
            ]
          }
        ]
      }
    },
    "tools": {
      "danger": {
        "description": "위험 작업",
        "results": [
          {
            "error": "도구 실패"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "error": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "model"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "conversationId": "c1",
        "input": "요청"
      }
    }
  ]
}
