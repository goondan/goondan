{
  "description": "같은 모델 응답의 다른 도구 호출은 재시도 대기 중에도 진행하며, 이미 결과를 저장한 호출은 다시 실행하지 않는다.",
  "spec": [
    "재시도"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "a",
                "args": {}
              },
              {
                "callId": "c-2",
                "name": "b",
                "args": {}
              },
              {
                "callId": "c-3",
                "name": "c",
                "args": {}
              },
              {
                "callId": "c-4",
                "name": "d",
                "args": {}
              }
            ]
          },
          {
            "text": "완료"
          }
        ]
      }
    },
    "tools": {
      "a": {
        "results": [
          {
            "text": "A"
          }
        ]
      },
      "b": {
        "results": [
          {
            "error": "b 실패"
          },
          {
            "text": "B"
          }
        ]
      },
      "c": {
        "results": [
          {
            "error": "c 실패"
          },
          {
            "text": "C"
          }
        ]
      },
      "d": {
        "results": [
          {
            "text": "D"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onError": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "tool",
                "afterMs": 20
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
