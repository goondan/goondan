              {
                "callId": "c-1",
                "name": "a",
                "args": {}
              },
              {
                "callId": "c-2",
                "name": "b",
                "args": {}
              },
              {
                "callId": "c-3",
                "name": "c",
                "args": {}
              },
              {
                "callId": "c-4",
                "name": "d",
                "args": {}
              }
            ]
          },
          {
            "text": "완료"
          }
        ]
      }
    },
    "tools": {
      "a": {
        "results": [
          {
            "text": "A"
          }
        ]
      },
      "b": {
        "results": [
          {
            "error": "b 실패"
          },
          {
            "text": "B"
          }
        ]
      },
      "c": {
        "results": [
          {
            "error": "c 실패"
          },
          {
            "text": "C"
          }
        ]
      },
      "d": {
        "results": [
          {
            "text": "D"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
