{
  "description": "target tool 재시도는 toolCall 단계를 마친 값 그대로 다시 처리하므로 toolCall 훅을 다시 실행하지 않는다.",
  "spec": [
    "재시도"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "flaky",
                "args": {}
              }
            ]
          },
          {
            "text": "완료"
          }
        ]
      }
    },
    "tools": {
      "flaky": {
        "description": "불안정",
        "results": [
          {
            "error": "일시 실패"
          },
          {
            "text": "결과"
          }
        ]
      }
    },
    "functions": {
      "tap": {
        "op": "identity"
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onError": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "tool"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
