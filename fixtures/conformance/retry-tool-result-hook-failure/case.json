{
  "description": "도구 실행이 성공한 뒤 toolResult 단계에서 발생한 실패는 훅 실패이므로 error 단계를 거치지 않고 성공한 도구를 다시 실행하지 않는다.",
  "spec": [
    "재시도"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "c-1",
                "name": "t",
                "args": {}
              }
            ]
          }
        ]
      }
    },
    "tools": {
      "t": {
        "description": "도구",
        "results": [
          {
            "text": "결과"
          }
        ]
      }
    },
    "extensions": {
      "policy": {
        "instance": {
          "hooks": {
            "onToolResult": {
              "op": "throw",
              "message": "toolResult 실패"
            },
            "onError": {
              "op": "constant",
              "value": {
                "retry": true,
                "target": "tool"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
