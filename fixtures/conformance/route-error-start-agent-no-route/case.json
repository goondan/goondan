  "bindings": {
    "models": {
      "ma": {
        "responses": []
      },
      "mb": {
        "responses": []
      },
      "ml": {
        "responses": [
          {
            "text": "응답"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "질문",
        "startAgent": "lone"
      }
