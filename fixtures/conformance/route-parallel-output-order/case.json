{
  "description": "일치한 두 route는 동시에 실행하며 완료 순서와 관계없이 outputs는 최종 route의 선언 순서를 따른다.",
  "spec": [
    "route 진행",
    "턴 결과"
  ],
  "bindings": {
    "models": {
      "splitModel": {
        "responses": [
          {
            "text": "분기"
          }
        ]
      },
      "leftModel": {
        "responses": [
          {
            "await": "left",
            "then": {
              "text": "L"
            }
          }
        ]
      },
      "rightModel": {
        "responses": [
          {
            "await": "right",
            "then": {
              "text": "R"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "s",
              "input": "시작"
            }
          }
        ],
        [
          {
            "reach": "left"
          },
          {
            "reach": "right"
          },
          {
            "release": "right"
          },
          {
            "release": "left"
          }
        ]
      ]
    }
  ]
}
