{
  "description": "하위 대화의 식별자로 요청한 실행 중단은 대상이 없으므로 false를 반환하고 훅 에이전트의 실행을 멈추지 않는다.",
  "spec": [
    "실행 중단",
    "하위 대화"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "끝"
          }
        ]
      },
      "h": {
        "responses": [
          {
            "await": "open",
            "then": {
              "text": "조언"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "시작"
            }
          }
        ],
        [
          {
            "reach": "open"
          },
          {
            "abort": {
              "conversationId": "c1:main:modelInput:advisors"
            }
          },
          {
            "release": "open"
          }
        ]
      ]
    }
  ]
}
