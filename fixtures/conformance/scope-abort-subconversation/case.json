{
  "description": "턴을 중단하면 그 턴이 시작한 하위 대화의 실행도 중단되며, 중단된 대상 에이전트 실행은 도구 실패로 바뀌지 않고 부모 실행도 같은 aborted 오류로 실패한다.",
  "spec": [
    "실행 중단",
    "에이전트 도구",
    "하위 대화"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "w-1",
                "name": "worker",
                "args": {
                  "n": 1
                }
              }
            ]
          }
        ]
      },
      "w": {
        "responses": [
          {
            "await": "never",
            "then": {
              "text": "늦음"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "시작"
            }
          }
        ],
        [
          {
            "reach": "never"
          },
          {
            "abort": {
              "conversationId": "c1"
            }
          }
        ]
      ]
    }
  ]
}
