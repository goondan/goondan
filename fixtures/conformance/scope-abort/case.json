{
  "description": "실행 중단은 진행 중인 턴을 aborted 실행 오류로 끝내고 true를 반환하며, 진행 중인 턴이 없거나 닫힌 런타임에 요청하면 false를 반환한다.",
  "spec": [
    "실행 중단"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "await": "never",
            "then": {
              "text": "늦은 응답"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "시작"
            }
          }
        ],
        [
          {
            "reach": "never"
          },
          {
            "abort": {
              "conversationId": "c1"
            }
          }
        ]
      ]
    },
    {
      "abort": {
        "conversationId": "c1"
      }
    },
    {
      "close": {}
    },
    {
      "abort": {
        "conversationId": "c1"
      }
    }
  ]
}
