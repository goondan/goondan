{
  "description": "하위 대화의 실행은 실행 중 입력을 받지 않으므로, 대상 에이전트가 실행 중일 때 보낸 값은 부모 흐름 단계의 대화에만 추가된다.",
  "spec": [
    "실행 중 입력",
    "하위 대화"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "toolCalls": [
              {
                "callId": "w-1",
                "name": "worker",
                "args": {
                  "n": 1
                }
              }
            ]
          },
          {
            "text": "끝"
          }
        ]
      },
      "w": {
        "responses": [
          {
            "await": "open",
            "then": {
              "text": "작업 완료"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "conversationId": "c1",
              "input": "시작"
            }
          }
        ],
        [
          {
            "reach": "open"
          },
          {
            "steer": {
              "conversationId": "c1",
              "value": "지시"
            }
          },
          {
            "release": "open"
          }
        ]
      ]
    }
  ]
}
