{
  "description": "군단 객체를 닫으면 같은 턴에 수락된 모든 run 핸들의 result가 aborted 실행 오류로 함께 실패한다.",
  "spec": [
    "세션",
    "군단 객체 종료와 작업",
    "입력 대기열과 턴"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {"await": "active", "then": {"text": "끝"}}
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "s",
        "input": "첫째",
        "awaitResult": false,
        "handle": "first"
      },
      "settle": false
    },
    {"reach": "active", "settle": false},
    {
      "run": {
        "sessionId": "s",
        "input": "둘째",
        "awaitResult": false,
        "handle": "second"
      },
      "settle": false
    },
    {"close": {}},
    {"awaitRun": {"handle": "first"}},
    {"awaitRun": {"handle": "second"}}
  ]
}
