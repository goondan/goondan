{
  "description": "군단 객체를 닫으면 같은 턴에 합류한 모든 run 호출이 턴의 aborted 실행 오류로 함께 실패한다.",
  "spec": [
    "세션",
    "군단 객체 종료와 작업",
    "입력 대기열과 턴"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "await": "active",
            "then": {
              "text": "끝"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "s",
              "input": "첫째"
            }
          }
        ],
        [
          {
            "reach": "active"
          },
          {
            "run": {
              "sessionId": "s",
              "input": "둘째"
            }
          }
        ],
        [
          {
            "reach": "active"
          },
          {
            "close": {}
          }
        ]
      ]
    }
  ]
}
