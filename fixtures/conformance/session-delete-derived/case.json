{
  "description": "sessions.delete는 지정한 세션의 대화와 그 턴이 만든 파생 세션의 대화를 함께 삭제한다.",
  "spec": ["세션", "파생 세션"],
  "bindings": {
    "models": {
      "mainModel": {"responses": [{"text": "완료"}]},
      "helperModel": {"responses": [{"text": "도움"}]}
    }
  },
  "steps": [
    {"run": {"sessionId": "s", "input": "원본"}},
    {"deleteSession": {"sessionId": "s"}}
  ]
}
