{
  "description": "sessions.delete는 세션의 대화와 실행 범위를 지우며 같은 세션의 다음 턴은 빈 대화에서 시작한다.",
  "spec": [
    "세션"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "첫 응답"
          },
          {
            "text": "둘째 응답"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "s",
        "input": "첫 입력"
      }
    },
    {
      "deleteSession": {
        "sessionId": "s"
      }
    },
    {
      "run": {
        "sessionId": "s",
        "input": "둘째 입력"
      }
    }
  ]
}
