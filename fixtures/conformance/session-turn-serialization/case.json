{
  "description": "같은 세션의 턴은 요청 순서대로 실행하며 두 번째 턴의 모델 입력은 첫 번째 턴이 저장한 대화를 이어받는다.",
  "spec": ["세션"],
  "bindings": {
    "models": {"m": {"responses": [
      {"await": "first", "then": {"text": "첫 응답"}},
      {"await": "second", "then": {"text": "둘째 응답"}}
    ]}}
  },
  "steps": [
    {"parallel": [
      [{"run": {"sessionId": "s", "input": "첫 입력"}}],
      [{"reach": "first"}, {"run": {"sessionId": "s", "input": "둘째 입력"}}],
      [{"reach": "first"}, {"release": "first"}, {"reach": "second"}, {"release": "second"}]
    ]}
  ]
}
