{
  "description": "진행 중인 같은 세션의 두 번째 run은 입력을 안전 지점에 합류시키고 두 호출은 같은 turnId와 턴 결과를 받는다.",
  "spec": [
    "세션",
    "입력 대기열과 턴",
    "턴 결과"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "await": "first",
            "then": {
              "text": "첫 응답"
            }
          },
          {
            "await": "second",
            "then": {
              "text": "둘째 응답"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "parallel": [
        [
          {
            "run": {
              "sessionId": "s",
              "input": "첫 입력"
            }
          }
        ],
        [
          {
            "reach": "first"
          },
          {
            "run": {
              "sessionId": "s",
              "input": "둘째 입력"
            }
          }
        ],
        [
          {
            "reach": "first"
          },
          {
            "release": "first"
          },
          {
            "reach": "second"
          },
          {
            "release": "second"
          }
        ]
      ]
    }
  ]
}
