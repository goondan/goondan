{
  "description": "stateless 비동기 훅이 완료 이벤트를 전달한 뒤 확장 인스턴스를 정리한다.",
  "spec": [
    "비동기 훅",
    "확장 인스턴스"
  ],
  "config": {
    "document": {
      "agents": {
        "main": {
          "model": "m",
          "stateful": false,
          "extensions": {
            "trace": {}
          },
          "hooks": {
            "onOutput": [
              {
                "extension": "trace",
                "mode": "async"
              }
            ]
          }
        }
      }
    }
  },
  "bindings": {
    "models": {
      "m": {
        "responses": [
          {
            "text": "done"
          }
        ]
      }
    },
    "extensions": {
      "trace": {
        "instance": {
          "hooks": {
            "onOutput": {
              "op": "await",
              "gate": "hook"
            }
          },
          "events": [
            "hook.applied"
          ]
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "s",
        "input": "hi"
      },
      "settle": false
    },
    {
      "reach": "hook"
    },
    {
      "release": "hook"
    },
    {
      "close": {}
    }
  ]
}
