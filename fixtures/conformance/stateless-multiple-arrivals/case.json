{
  "description": "stateless 에이전트는 route가 도달할 때마다 빈 대화에서 독립 실행하고, 각 실행의 대화를 고유 인스턴스로 저널에 기록한다.",
  "spec": [
    "인스턴스",
    "에이전트 실행 기록"
  ],
  "bindings": {
    "models": {
      "splitModel": {
        "responses": [
          {
            "text": "분기"
          }
        ]
      },
      "workerModel": {
        "responses": [
          {
            "text": "첫째"
          },
          {
            "text": "둘째"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "s",
        "input": "시작"
      }
    }
  ]
}
