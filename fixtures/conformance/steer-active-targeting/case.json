{
  "description": "진행 중인 흐름 실행이 하나이면 agent 없는 실행 중 입력은 그 실행을 자동 지정하고 agent로 지정한 값과 대기열 순서대로 받는다.",
  "spec": ["실행 중 입력", "단계 실행 순서"],
  "bindings": {
    "models": {"m": {"responses": [
      {"toolCalls": [{"callId": "p-1", "name": "pause", "args": {}}]},
      {"text": "완료"}
    ]}},
    "tools": {"pause": {"results": [{"await": "tool-running", "then": {"text": "계속"}}]}}
  },
  "steps": [{"parallel": [
    [{"run": {"sessionId": "s", "input": "시작"}}],
    [{"reach": "tool-running"}, {"steer": {"sessionId": "s", "value": "자동"}}, {"steer": {"sessionId": "s", "value": {"tag": true}, "agent": "main"}}, {"release": "tool-running"}]
  ]}]
}
