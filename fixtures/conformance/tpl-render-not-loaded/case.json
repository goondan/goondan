{
  "description": "훅 컨텍스트의 render는 이미 읽은 템플릿만 렌더링하므로 그 밖의 경로를 받으면 파일을 읽지 않고 실패하고, 그 훅이 실패한다.",
  "spec": [
    "템플릿을 읽는 시점"
  ],
  "bindings": {
    "models": {
      "m": {
        "responses": []
      }
    },
    "extensions": {
      "memo": {
        "instance": {
          "hooks": {
            "onStep": {
              "op": "render",
              "template": "goondan.yaml",
              "variables": {}
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "run": {
        "sessionId": "c1",
        "input": "요청"
      }
    }
  ]
}
