{
  "name": "@goondan/cli",
  "version": "0.1.2",
  "description": "Goondan CLI (gdn): run a goondan.yaml, inspect the effective config and chat with a legion from the terminal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goondan/goondan.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/goondan/goondan#readme",
  "bugs": {
    "url": "https://github.com/goondan/goondan/issues"
  },
  "keywords": [
    "goondan",
    "agent",
    "runtime",
    "llm",
    "yaml"
  ],
  "type": "module",
  "bin": {
    "gdn": "dist/goondan-bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/goondan-bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @goondan/core --filter @goondan/models build && vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@goondan/core": "workspace:*",
    "@goondan/models": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
