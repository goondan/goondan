{
  "name": "@goondan/cli",
  "version": "0.0.3-alpha29",
  "description": "Goondan CLI (gdn)",
  "type": "module",
  "bin": {
    "gdn": "dist/goondan-bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/goondan-bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @goondan/core build && vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@goondan/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
