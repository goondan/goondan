{
  "name": "@goondan/core",
  "version": "0.1.2",
  "description": "Goondan runtime for TypeScript: runs YAML-declared agents, routes and hooks over a per-session journal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goondan/goondan.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/goondan/goondan#readme",
  "bugs": {
    "url": "https://github.com/goondan/goondan/issues"
  },
  "keywords": [
    "goondan",
    "agent",
    "runtime",
    "llm",
    "yaml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema:sync": "cp ../../spec/goondan.schema.json src/goondan.schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "nunjucks": "^3.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/nunjucks": "^3.2.6"
  }
}
