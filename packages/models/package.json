{
  "name": "@goondan/models",
  "version": "0.1.0",
  "description": "Official Goondan model adapters for the Anthropic Messages and OpenAI Chat Completions APIs, specified by spec/model-adapters.md and verified by shared fixtures in both hosts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goondan/goondan.git",
    "directory": "packages/models"
  },
  "homepage": "https://github.com/goondan/goondan#readme",
  "bugs": {
    "url": "https://github.com/goondan/goondan/issues"
  },
  "keywords": [
    "goondan",
    "agent",
    "runtime",
    "llm",
    "yaml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@goondan/core": "workspace:^"
  },
  "devDependencies": {
    "@goondan/core": "workspace:*",
    "@types/node": "^22.19.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
