{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goondan.dev/schema/config-v1.json",
  "title": "Goondan Config v1",
  "description": "합성을 마친 Goondan 구성 문서와 유효 구성의 구조다. 최상위 문서 하나는 군단(goondan) 하나를 정의한다. 스키마 단계는 version과 name의 기본값만 채운 합성 결과를, 참조 단계는 상속과 제거를 적용한 유효 구성을 이 스키마로 검사한다. extends, resources와 variant로 합성하는 개별 YAML 파일은 부분 구성일 수 있으므로 파일마다 이 스키마를 적용하지 않는다. 읽기 단계는 각 파일의 extends와 resources를 $defs/extends와 $defs/resources로 검사한다. $defs/message와 $defs/part는 구성이 아니라 단계 값의 메시지 형식이다.",
  "$comment": "두 호스트의 검사기가 같은 결과를 내도록 draft 2020-12 키워드 가운데 $schema, $id, $comment, title, description, default, $defs, 로컬 $ref, type, const, enum, properties, required, additionalProperties, propertyNames, minProperties, items, minItems, uniqueItems, minLength, pattern, exclusiveMinimum, oneOf, anyOf, allOf, not, dependentSchemas만 사용한다. pattern에는 ECMA-262와 Python re에서 같게 동작하는 식만 쓴다. Python의 $는 문자열 끝의 줄바꿈 앞에서도 일치하므로 문자열 끝은 (?![\\s\\S])로 나타낸다.",
  "type": "object",
  "required": [
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "구성 형식의 버전이다. 생략하면 1이다.",
      "const": 1,
      "default": 1
    },
    "name": {
      "description": "군단의 이름이다. 생략하면 goondan이다.",
      "type": "string",
      "minLength": 1,
      "default": "goondan"
    },
    "agents": {
      "description": "이름으로 식별하는 에이전트 맵이다. 선언 순서가 routes를 생략했을 때 실행할 에이전트를 정한다.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/agentName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "routes": {
      "description": "군단의 진입 $input에서 에이전트를 거쳐 종료 $output에 이르는 route의 배열이다. 에이전트 이름 배열은 직렬 실행의 축약형이다. 생략하면 agents에 처음 선언된 에이전트 하나만 실행한다.",
      "oneOf": [
        {
          "$ref": "#/$defs/routes"
        },
        {
          "$ref": "#/$defs/serialRoutes"
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "description": "읽기 단계가 각 파일의 extends를 검사하는 정의다. 합성을 마친 구성 문서에는 extends가 없다.",
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "description": "읽기 단계가 각 파일의 resources를 검사하는 정의다. 합성을 마친 구성 문서에는 resources가 없다.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "agentName": {
      "description": "에이전트 이름은 비어 있지 않고 /와 $를 포함하지 않으며, 앞자리 0 없이 10진수로 쓴 음이 아닌 정수가 아니다.",
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "/"
          }
        },
        {
          "not": {
            "pattern": "\\$"
          }
        },
        {
          "not": {
            "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stateful": {
          "description": "대화를 저장하고 이어 갈지 정한다. 생략하면 true다.",
          "type": "boolean"
        },
        "params": {
          "type": "object"
        },
        "input": {
          "oneOf": [
            {
              "const": "asis"
            },
            {
              "$ref": "#/$defs/inputRule"
            }
          ]
        },
        "systemMessage": {
          "oneOf": [
            {
              "$ref": "#/$defs/systemBlock"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/systemBlock"
              }
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/extension"
          }
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "inherit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "model"
          ]
        },
        {
          "required": [
            "inherit"
          ]
        }
      ]
    },
    "inputRule": {
      "type": "object",
      "properties": {
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "systemBlock": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cache": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "tool"
              ]
            },
            {
              "required": [
                "agent"
              ]
            }
          ],
          "properties": {
            "tool": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "agent": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "hint": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "approval": {
              "const": "required"
            }
          },
          "additionalProperties": false,
          "dependentSchemas": {
            "agent": {
              "properties": {
                "hint": false
              }
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "options": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "enum": [
        "input",
        "conversation",
        "modelInput",
        "modelResult",
        "toolCall",
        "toolResult",
        "output",
        "error"
      ]
    },
    "hooks": {
      "description": "값 처리 단계 이름을 키로, 그 단계의 훅 배열을 값으로 갖는다. mode: async는 conversation 단계에서만, role은 conversation과 modelInput 단계에서만 선언할 수 있다.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/phase"
      },
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHookWithoutRole"
          }
        },
        "conversation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "modelInput": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHook"
          }
        },
        "modelResult": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHookWithoutRole"
          }
        },
        "toolCall": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHookWithoutRole"
          }
        },
        "toolResult": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHookWithoutRole"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHookWithoutRole"
          }
        },
        "error": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncHookWithoutRole"
          }
        }
      }
    },
    "hook": {
      "description": "훅은 extension, fn, agent, template 가운데 하나 이상을 선언한다. extension 훅에는 fn, agent, template, role을 함께 선언할 수 없고, timeout을 선언한 훅은 동기 훅이어야 한다.",
      "type": "object",
      "properties": {
        "extension": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "agent": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          ]
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "using": {
          "oneOf": [
            {
              "enum": [
                "input",
                "conversation"
              ]
            },
            {
              "$ref": "#/$defs/fnRef"
            }
          ]
        },
        "when": {
          "$ref": "#/$defs/fnRef"
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "role": {
          "enum": [
            "user",
            "system"
          ]
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "extension"
          ]
        },
        {
          "required": [
            "fn"
          ]
        },
        {
          "required": [
            "agent"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ],
      "dependentSchemas": {
        "extension": {
          "properties": {
            "fn": false,
            "agent": false,
            "template": false,
            "role": false
          }
        },
        "timeout": {
          "properties": {
            "mode": {
              "const": "sync"
            }
          }
        }
      }
    },
    "syncHook": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "properties": {
            "mode": {
              "const": "sync"
            }
          }
        }
      ]
    },
    "syncHookWithoutRole": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "properties": {
            "mode": {
              "const": "sync"
            },
            "role": false
          }
        }
      ]
    },
    "fnRef": {
      "type": "object",
      "required": [
        "fn"
      ],
      "properties": {
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "remove": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "hooks": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/phase"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "serialRoutes": {
      "description": "에이전트 이름의 배열이다. $input에서 첫 항목으로, 각 항목에서 다음 항목으로, 마지막 항목에서 $output으로 가는 route와 같다.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "route": {
      "description": "from은 에이전트 이름 또는 $input, to는 에이전트 이름 또는 $output이다. when을 생략하면 항상 일치한다.",
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "to": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "when": {
          "$ref": "#/$defs/routeWhen"
        }
      },
      "additionalProperties": false
    },
    "routeWhen": {
      "description": "fn과 output 가운데 정확히 하나를 선언한다. fn은 {output, text, input}을 받아 불리언을 반환하는 호스트 함수 이름이다. output은 조건의 text(출발점이 에이전트이면 출력 메시지의 text 부분만 이어 붙인 출력 텍스트, $input이면 턴 입력의 입력 텍스트)와 같은지 비교할 문자열 또는 그 text를 JSON으로 해석한 객체와 부분 일치를 확인할 객체다.",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "fn"
          ]
        },
        {
          "required": [
            "output"
          ]
        }
      ],
      "properties": {
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "message": {
      "description": "대화 메시지다. 턴 입력과 에이전트 입력은 이 메시지의 배열이다. 값이 없는 선택 필드는 null로 채우지 않고 키를 생략한다.",
      "type": "object",
      "required": [
        "id",
        "role",
        "content",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "source": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "keep": {
          "type": "boolean"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "part": {
      "description": "메시지 content의 부분이다. image는 url로, media는 호스트가 해석하는 ref와 mediaType으로 파일을 참조하며, 파일 내용을 직접 담는 부분은 없다.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "url": {
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "ref",
            "mediaType"
          ],
          "properties": {
            "type": {
              "const": "media"
            },
            "ref": {
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "callId",
            "name",
            "args"
          ],
          "properties": {
            "type": {
              "const": "tool.call"
            },
            "callId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "args": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "callId",
            "content"
          ],
          "properties": {
            "type": {
              "const": "tool.result"
            },
            "callId": {
              "type": "string"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/part"
              }
            },
            "isError": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
