{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "de27812e716941f6b8029b78363a4ccedea893e2",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "bump-minor-pre-major": true,
  "plugins": [
    {
      "type": "node-workspace",
      "updatePeerDependencies": true
    }
  ],
  "packages": {
    "packages/core": {
      "release-type": "node",
      "component": "core"
    },
    "packages/models": {
      "release-type": "node",
      "component": "models"
    },
    "packages/cli": {
      "release-type": "node",
      "component": "cli"
    },
    "python/goondan": {
      "release-type": "python",
      "component": "goondan",
      "package-name": "goondan"
    }
  }
}
