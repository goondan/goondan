{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goondan.dev/schema/config-v1.json",
  "title": "Goondan Config v1",
  "description": "합성을 마친 Goondan 구성 문서와 유효 구성의 구조다. 최상위 문서 하나는 군단(goondan) 하나를 정의한다. 스키마 단계는 version과 name의 기본값만 채운 합성 결과를, 참조 단계는 상속과 제거를 적용한 유효 구성을 이 스키마로 검사한다. resources와 variant로 합성하는 개별 YAML 파일은 부분 구성일 수 있으므로 파일마다 이 스키마를 적용하지 않는다. 읽기 단계는 각 파일의 resources를 $defs/resources로 검사한다. $defs/message, $defs/part, $defs/journalEvent와 $defs/journalState는 구성 밖에서 쓰는 실행 값의 형식이다.",
  "$comment": "두 호스트의 검사기가 같은 결과를 내도록 draft 2020-12 키워드 가운데 $schema, $id, $comment, title, description, default, $defs, 로컬 $ref, type, const, enum, properties, required, additionalProperties, propertyNames, minProperties, items, minItems, uniqueItems, minLength, pattern, exclusiveMinimum, oneOf, anyOf, allOf, not, dependentSchemas만 사용한다. pattern에는 ECMA-262와 Python re에서 같게 동작하는 식만 쓴다. Python의 $는 문자열 끝의 줄바꿈 앞에서도 일치하므로 문자열 끝은 (?![\\s\\S])로 나타낸다.",
  "type": "object",
  "required": [
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "구성 형식의 버전이다. 생략하면 1이다.",
      "const": 1,
      "default": 1
    },
    "name": {
      "description": "군단의 이름이다. 생략하면 goondan이다.",
      "type": "string",
      "minLength": 1,
      "default": "goondan"
    },
    "agents": {
      "description": "이름으로 식별하는 에이전트 맵이다. 선언 순서가 routes를 생략했을 때 실행할 에이전트를 정한다.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/agentName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "routes": {
      "description": "군단의 진입 $input에서 에이전트를 거쳐 종료 $output에 이르는 route의 배열이다. 에이전트 이름 배열은 직렬 실행의 축약형이다. 생략하면 agents에 처음 선언된 에이전트 하나만 실행한다.",
      "oneOf": [
        {
          "$ref": "#/$defs/routes"
        },
        {
          "$ref": "#/$defs/serialRoutes"
        }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "description": "읽기 단계가 각 파일의 resources를 검사하는 정의다. 합성을 마친 구성 문서에는 resources가 없다.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "agentName": {
      "description": "에이전트 이름은 비어 있지 않고 /와 $를 포함하지 않으며, 앞자리 0 없이 10진수로 쓴 음이 아닌 정수가 아니다.",
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "/"
          }
        },
        {
          "not": {
            "pattern": "\\$"
          }
        },
        {
          "not": {
            "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stateful": {
          "description": "대화를 저장하고 이어 갈지 정한다. 생략하면 true다.",
          "type": "boolean"
        },
        "params": {
          "type": "object"
        },
        "input": {
          "oneOf": [
            {
              "const": "asis"
            },
            {
              "$ref": "#/$defs/inputRule"
            }
          ]
        },
        "systemMessage": {
          "oneOf": [
            {
              "$ref": "#/$defs/systemBlock"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/systemBlock"
              }
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/extension"
          }
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "inherit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "model"
          ]
        },
        {
          "required": [
            "inherit"
          ]
        }
      ]
    },
    "inputRule": {
      "type": "object",
      "properties": {
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "systemBlock": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cache": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "tool"
              ]
            },
            {
              "required": [
                "agent"
              ]
            }
          ],
          "properties": {
            "tool": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "agent": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "hint": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "approval": {
              "const": "required"
            }
          },
          "additionalProperties": false,
          "dependentSchemas": {
            "agent": {
              "properties": {
                "hint": false
              }
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "options": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "enum": [
        "onInput",
        "onPrompt",
        "onStep",
        "onModelInput",
        "onModelResult",
        "onToolCall",
        "onToolResult",
        "onOutput",
        "onError"
      ]
    },
    "hooks": {
      "description": "처리 시점 이름을 키로, 그 시점의 훅 배열을 값으로 갖는다. 비동기 훅은 모든 시점에 허용한다.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/phase"
      },
      "properties": {
        "onInput": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformHook"
          }
        },
        "onPrompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promptHook"
          }
        },
        "onStep": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promptHook"
          }
        },
        "onModelInput": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promptHook"
          }
        },
        "onModelResult": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformHook"
          }
        },
        "onToolCall": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformHook"
          }
        },
        "onToolResult": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformHook"
          }
        },
        "onOutput": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputHook"
          }
        },
        "onError": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformHook"
          }
        }
      },
      "additionalProperties": false
    },
    "hook": {
      "description": "훅은 extension, fn, agent, template 가운데 정확히 하나를 선언한다.",
      "type": "object",
      "properties": {
        "extension": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "agent": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          ]
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "when": {
          "$ref": "#/$defs/fnRef"
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ],
          "default": "sync"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "role": {
          "enum": [
            "user",
            "system"
          ]
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "extension"
          ]
        },
        {
          "required": [
            "fn"
          ]
        },
        {
          "required": [
            "agent"
          ]
        },
        {
          "required": [
            "template"
          ]
        }
      ],
      "dependentSchemas": {
        "extension": {
          "properties": {
            "fn": false,
            "agent": false,
            "template": false,
            "role": false
          }
        }
      }
    },
    "asyncHook": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "async"
            }
          }
        }
      ]
    },
    "syncTransformHook": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "properties": {
            "mode": {
              "const": "sync"
            },
            "agent": false,
            "template": false,
            "role": false
          }
        }
      ]
    },
    "syncMessageHook": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "required": [
            "role"
          ],
          "properties": {
            "mode": {
              "const": "sync"
            },
            "extension": false
          }
        }
      ]
    },
    "syncAgentMessageHook": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "properties": {
            "mode": {
              "const": "sync"
            },
            "extension": false,
            "fn": false,
            "role": false
          }
        }
      ]
    },
    "syncOutputHook": {
      "allOf": [
        {
          "$ref": "#/$defs/hook"
        },
        {
          "properties": {
            "mode": {
              "const": "sync"
            },
            "extension": false,
            "fn": false,
            "role": false
          }
        }
      ]
    },
    "transformHook": {
      "oneOf": [
        {"$ref": "#/$defs/asyncHook"},
        {"$ref": "#/$defs/syncTransformHook"}
      ]
    },
    "promptHook": {
      "oneOf": [
        {"$ref": "#/$defs/asyncHook"},
        {"$ref": "#/$defs/syncTransformHook"},
        {"$ref": "#/$defs/syncMessageHook"},
        {"$ref": "#/$defs/syncAgentMessageHook"}
      ]
    },
    "outputHook": {
      "oneOf": [
        {"$ref": "#/$defs/asyncHook"},
        {"$ref": "#/$defs/syncTransformHook"},
        {"$ref": "#/$defs/syncOutputHook"}
      ]
    },
    "fnRef": {
      "type": "object",
      "required": [
        "fn"
      ],
      "properties": {
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "remove": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "hooks": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/phase"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "serialRoutes": {
      "description": "에이전트 이름의 배열이다. $input에서 첫 항목으로, 각 항목에서 다음 항목으로, 마지막 항목에서 $output으로 가는 route와 같다.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "route": {
      "description": "from과 to는 예약 이름, 에이전트 이름 또는 함수 노드다. when을 생략하면 항상 일치한다.",
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "oneOf": [
            {"$ref": "#/$defs/nonEmptyString"},
            {"$ref": "#/$defs/fnRef"}
          ]
        },
        "to": {
          "oneOf": [
            {"$ref": "#/$defs/nonEmptyString"},
            {"$ref": "#/$defs/fnRef"}
          ]
        },
        "when": {
          "$ref": "#/$defs/routeWhen"
        }
      },
      "additionalProperties": false
    },
    "routeWhen": {
      "description": "fn과 output 가운데 정확히 하나를 선언한다. fn은 {output, text, input}을 받아 불리언을 반환하는 호스트 함수 이름이다. output은 조건의 text(출발점이 에이전트이면 출력 메시지의 text 부분만 이어 붙인 출력 텍스트, $input이면 턴 입력의 입력 텍스트)와 같은지 비교할 문자열 또는 그 text를 JSON으로 해석한 객체와 부분 일치를 확인할 객체다.",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "fn"
          ]
        },
        {
          "required": [
            "output"
          ]
        }
      ],
      "properties": {
        "fn": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "message": {
      "description": "대화 메시지다. 턴 입력과 에이전트 입력은 이 메시지의 배열이다. 값이 없는 선택 필드는 null로 채우지 않고 키를 생략한다.",
      "type": "object",
      "required": [
        "id",
        "role",
        "content",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "source": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "keep": {
          "type": "boolean"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "part": {
      "description": "메시지 content의 부분이다. image는 url로, media는 호스트가 해석하는 ref와 mediaType으로 파일을 참조하며, 파일 내용을 직접 담는 부분은 없다.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "url": {
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "ref",
            "mediaType"
          ],
          "properties": {
            "type": {
              "const": "media"
            },
            "ref": {
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "callId",
            "name",
            "args"
          ],
          "properties": {
            "type": {
              "const": "tool.call"
            },
            "callId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "args": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "callId",
            "content"
          ],
          "properties": {
            "type": {
              "const": "tool.result"
            },
            "callId": {
              "type": "string"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/part"
              }
            },
            "isError": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "nonNegativeInteger": {
      "type": "integer",
      "exclusiveMinimum": -1
    },
    "positiveInteger": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolCall": {
      "type": "object",
      "required": [
        "id",
        "name",
        "args"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": true
      },
      "additionalProperties": false
    },
    "toolResult": {
      "type": "object",
      "required": [
        "callId",
        "name",
        "args",
        "content"
      ],
      "properties": {
        "callId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": true,
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "isError": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "input",
        "cacheRead",
        "cacheWrite",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "cacheRead": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "cacheWrite": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "output": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "agentRun": {
      "type": "object",
      "required": [
        "agent",
        "instance",
        "executionId",
        "turnId",
        "kind",
        "usage",
        "status"
      ],
      "properties": {
        "agent": {"$ref": "#/$defs/nonEmptyString"},
        "instance": {"$ref": "#/$defs/nonEmptyString"},
